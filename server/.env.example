# ================================
# EventSphere Server - Environment Configuration
# ================================
# Copy this file to .env and fill in your actual values

# ================================
# SERVER CONFIGURATION
# ================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ================================
# DATABASE CONFIGURATION
# ================================
DATABASE_URL=postgresql://user:password@localhost:5432/drishtix
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drishtix
DB_USER=drishtix_user
DB_PASSWORD=your-secure-password

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ================================
# JWT AUTHENTICATION
# ================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ISSUER=drishtix-platform
JWT_AUDIENCE=drishtix-api
JWT_EXPIRATION=24h

# ================================
# GOOGLE CLOUD PLATFORM (CRITICAL)
# ================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account-key.json

# ================================
# VERTEX AI CONFIGURATION
# ================================
VERTEX_AI_ENDPOINT=us-central1-aiplatform.googleapis.com
VERTEX_AI_MODEL_ID=
VERTEX_AI_AGENT_ID=

# ================================
# GEMINI API CONFIGURATION
# ================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_TOKENS=2048

# ================================
# GOOGLE CLOUD PUB/SUB
# ================================
PUBSUB_TOPIC_CROWD_DATA=crowd-density-updates
PUBSUB_TOPIC_PREDICTIONS=prediction-results
PUBSUB_TOPIC_ANOMALIES=anomaly-detections
PUBSUB_TOPIC_ALERTS=emergency-alerts
PUBSUB_TOPIC_DISPATCH=responder-dispatch
PUBSUB_TOPIC_RISK_ENGINE=risk-engine

# ================================
# FIREBASE CONFIGURATION
# ================================
# Firebase Admin SDK (for FCM, Auth verification, Firestore admin operations)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-sender-id
ENABLE_FCM_NOTIFICATIONS=true

# Firebase Authentication
ENABLE_FIREBASE_AUTH=true
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBSUB_SUBSCRIPTION_CROWD=crowd-density-sub
PUBSUB_SUBSCRIPTION_PREDICTIONS=prediction-results-sub
PUBSUB_SUBSCRIPTION_ANOMALIES=anomaly-detections-sub
PUBSUB_SUBSCRIPTION_RISK_ENGINE=risk-engine-sub

# ================================
# BIGQUERY CONFIGURATION
# ================================
BIGQUERY_DATASET=drishtix_analytics
BIGQUERY_TABLE_PREDICTIONS=crowd_predictions
BIGQUERY_TABLE_INCIDENTS=incident_logs
BIGQUERY_TABLE_ANALYTICS=event_analytics
BIGQUERY_LOCATION=US

# ================================
# GOOGLE CLOUD STORAGE
# ================================
GCS_BUCKET_SIMULATIONS=drishtix-simulations
GCS_BUCKET_MODELS=drishtix-models
GCS_BUCKET_VIDEOS=drishtix-video-feeds

# ================================
# CLOUD DLP (Data Loss Prevention)
# ================================
DLP_ENABLED=false
DLP_TEMPLATE_ID=

# ================================
# GOOGLE MAPS PLATFORM
# ================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_ROUTES_API_KEY=your-routes-api-key
GOOGLE_MAPS_PLACES_API_KEY=your-places-api-key
GOOGLE_ROUTES_API_KEY=your-routes-api-key

# ================================
# EARTH ENGINE CONFIGURATION
# ================================
EARTH_ENGINE_ENABLED=false
EARTH_ENGINE_PROJECT=your-ee-project-id

# ================================
# WEATHER API (OpenWeatherMap)
# ================================
OPENWEATHER_API_KEY=your-openweather-api-key
WEATHER_UPDATE_INTERVAL=600000

# ================================
# SOCIAL MEDIA APIS
# ================================
# Twitter/X API v2
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# ================================
# TRAFFIC & MOBILITY APIS
# ================================
# Waze for Cities API
WAZE_API_KEY=your-waze-api-key
WAZE_BASE_URL=https://www.waze.com/partnerhub-api/feeds

# Google Mobility Data
GOOGLE_MOBILITY_DATA_URL=https://www.gstatic.com/covid19/mobility/Global_Mobility_Report.csv

# ================================
# TWILIO CONFIGURATION (SMS/WhatsApp)
# ================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ================================
# FIREBASE CONFIGURATION
# ================================
FIREBASE_SERVER_KEY=your-firebase-server-key
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-sender-id
ENABLE_FCM_NOTIFICATIONS=true

# ================================
# VIDEO ANALYTICS CONFIGURATION
# ================================
# Camera Stream Settings
ENABLE_CAMERA_STREAMS=true
CAMERA_FPS=5
FFMPEG_PATH=ffmpeg
VIDEO_FRAME_RATE=1
VIDEO_SIMULATION_ENABLED=true

# YOLO Detection
YOLO_MODEL_PATH=./weights/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5

# Face Recognition
ENABLE_FACIAL_RECOGNITION=true
FACE_RECOGNITION_INTERVAL=10

# Object Detection
ENABLE_OBJECT_DETECTION=true
OBJECT_DETECTION_INTERVAL=5

# ================================
# ML & PREDICTION SETTINGS
# ================================
ML_MODEL_VERSION=v1.0
PREDICTION_LEAD_TIME_MINUTES=15
FORECAST_ACCURACY_THRESHOLD=0.75
FALSE_POSITIVE_THRESHOLD=0.15
ANOMALY_DETECTION_SENSITIVITY=medium

# ConvLSTM Service
CONVLSTM_SERVICE_ENDPOINT=http://localhost:5000
CONVLSTM_USE_REMOTE=false
FORECAST_DEFAULT_MODE=GENERAL
FORECAST_ALLOWED_MODES=GENERAL,SPORTS,CONCERT,ENTRY_EXIT
FORECAST_BUFFER_SIZE=10
MODEL_REGISTRY_PATH=./weights

# ================================
# ANOMALY DETECTION (TIERED SYSTEM)
# ================================
# Tier 1 (Rule-Based)
ANOMALY_TIER1_DENSITY_THRESHOLD=0.95
ANOMALY_TIER1_DELTA_THRESHOLD=50

# Tier 2 (Isolation Forest)
ANOMALY_ISOLATION_FOREST_ENABLED=true
ANOMALY_IF_THRESHOLD=-0.2
ANOMALY_IF_ENDPOINT=

# Tier 3 (Autoencoder)
ANOMALY_AUTOENCODER_ENABLED=true
ANOMALY_AUTOENCODER_ENDPOINT=
ANOMALY_AUTOENCODER_THRESHOLD=0.15

# Historical Requirements
ANOMALY_MIN_ZONE_HISTORY_MINUTES=30
FEATURE_VECTOR_TABLE=event_feature_vectors
FEATURE_VECTOR_DATASET=drishtix_analytics

# Pub/Sub Topics
ANOMALY_PUBSUB_TOPIC=anomaly-events
HEATGRID_PUBSUB_TOPIC=heatgrid-stream

# ================================
# RISK ENGINE CONFIGURATION
# ================================
RISK_ENGINE_PUBSUB_TOPIC=risk-engine
RISK_THRESHOLD_CRITICAL=85
RISK_THRESHOLD_HIGH=70
RISK_THRESHOLD_MEDIUM=50

# ================================
# RECOMMENDATION ENGINE
# ================================
RECOMMENDATION_ENGINE_ENABLED=true
RECOMMENDATION_CONTEXT_WINDOW_MINUTES=30
RECOMMENDATION_MAX_ACTIONS=5
RECOMMENDATION_MIN_CONFIDENCE=0.6
RECOMMENDATION_FEEDBACK_TABLE=drishtix_analytics.recommendation_feedback
RECOMMENDATION_FEEDBACK_DATASET=drishtix_analytics

# ================================
# PREDICTION SETTINGS
# ================================
PREDICTION_INTERVAL_MS=60000
FORECAST_HORIZON_MINUTES=20
PREDICTION_CONFIDENCE_THRESHOLD=0.75
HOTSPOT_THRESHOLD=0.80
RISK_ESCALATION_THRESHOLD=0.85

# ================================
# ANOMALY DETECTION THRESHOLDS
# ================================
ANOMALY_CHECK_INTERVAL_MS=5000
PANIC_DETECTION_THRESHOLD=0.70
FIRE_DETECTION_THRESHOLD=0.80
VIOLENCE_DETECTION_THRESHOLD=0.75
SURGE_DETECTION_THRESHOLD=0.80

# ================================
# RESPONSE AUTOMATION
# ================================
AUTO_DISPATCH_ENABLED=false
HUMAN_VALIDATION_REQUIRED=true
RESPONSE_TIME_TARGET_MINUTES=5

# ================================
# SIMULATION MODE
# ================================
SIMULATION_MODE=false
SIMULATION_FEED_FPS=30

# ================================
# PRIVACY & COMPLIANCE
# ================================
PII_SCRUBBING_ENABLED=true
AUDIT_LOGS_ENABLED=true
DATA_RETENTION_DAYS=90

# ================================
# REAL-TIME COMMUNICATION
# ================================
WEBSOCKET_ENABLED=true

# ================================
# LOCALIZATION
# ================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,es,fr,ar

# ================================
# SECURITY & RBAC
# ================================
RBAC_ENABLED=true
RBAC_ROLES=ADMIN,ORGANIZER,SECURITY,LOGISTICS,MEDICAL,ATTENDEE,VOLUNTEER,VIEWER
REQUIRE_MFA_FOR_ADMINS=true
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT_MINUTES=60

# ================================
# CLOUD LOGGING & MONITORING
# ================================
ENABLE_CLOUD_LOGGING=true
LOG_LEVEL=info
ALERT_FAILED_LOGIN_THRESHOLD=5
ALERT_SLOW_REQUEST_THRESHOLD=5000
ALERT_ERROR_RATE_THRESHOLD=0.05

# ================================
# PERFORMANCE SETTINGS
# ================================
DATA_REFRESH_INTERVAL_SECONDS=300
PREDICTION_UPDATE_INTERVAL_SECONDS=60
CACHE_TTL_SECONDS=600

# ================================
# CLOUD FUNCTIONS URLS
# ================================
CLOUD_FUNCTION_ALERT_TRIGGER_URL=
CLOUD_FUNCTION_REWARD_TRIGGER_URL=
CLOUD_FUNCTION_TWILIO_WEBHOOK_URL=
API_BASE_URL=http://localhost:3000

# ================================
# INCIDENT RESPONSE
# ================================
ENABLE_INCIDENT_DETECTION=true
ENABLE_AUTO_CONTAINMENT=false
INCIDENT_NOTIFICATION_EMAIL=security@drishtix.com
INCIDENT_WEBHOOK_URL=

# ================================
# VOICE AI CONFIGURATION
# ================================
ENABLE_VOICE_AI=true
VOICE_AI_LANGUAGE=en
SPEECH_TO_TEXT_ENABLED=false

# ================================
# ADDITIONAL GCP SERVICES
# ================================
CLOUD_RUN_SERVICE_ACCOUNT=
CLOUD_RUN_MAX_INSTANCES=100
CLOUD_RUN_MEMORY=2Gi
KMS_KEYRING=drishtix-keys
KMS_KEY=data-encryption-key

# ================================
# FEATURE FLAGS
# ================================
ENABLE_WEBSOCKET=true
ENABLE_GEOLOCATION=true
ENABLE_PWA=true
ENABLE_PREDICTIVE_ANALYTICS=true
ENABLE_SYNTHETIC_FEEDS=true
ENABLE_SOCIAL_MONITORING=true
ENABLE_AUTOMATED_ROUTING=true
ENABLE_VIDEO_ANALYTICS=true
ENABLE_TRAFFIC_FEEDS=true
ENABLE_AGENT_ORCHESTRATION=true
ENABLE_GEMINI_SUMMARIES=true
ENABLE_ATTENDEE_REPORTING=true
ENABLE_DATAFLOW_PIPELINE=false
ENABLE_CONVLSTM_FORECASTING=true
ENABLE_ENSEMBLE_MODELS=true
