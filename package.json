  "scripts": {
    "dev": "vite",
    "dev:server": "nodemon --watch server --ext ts --exec tsx server/index.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:server\"",
    "build": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "verify-setup": "tsx scripts/verify-setup.ts",
    "setup": "pnpm install && pnpm db:generate && pnpm verify-setup",
    "drishtix:setup": "tsx scripts/drishtix-setup.ts",
    "gcp:init": "tsx scripts/initialize-gcp-services.ts",
    "health:check": "tsx scripts/health-check.ts",
    "train:convlstm": "python scripts/train-convlstm.py --mode train",
    "train:isolation-forest": "python scripts/train-isolation-forest.py --mode train",
    "train:autoencoder": "python scripts/train-autoencoder.py --mode train",
    "train:all": "python scripts/train-convlstm.py --mode train && python scripts/train-isolation-forest.py --mode train && python scripts/train-autoencoder.py --mode train"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
