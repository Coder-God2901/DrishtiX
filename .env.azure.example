# ============================================================================
# Azure Configuration for DrishtiX Platform
# ============================================================================
# This file contains all Azure service configurations
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# AZURE CORE SETTINGS
# ============================================================================
AZURE_TENANT_ID=your-tenant-id
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=drishtix-rg
AZURE_LOCATION=eastus

# ============================================================================
# AZURE AD (Microsoft Entra ID) - Authentication
# ============================================================================
# Azure AD Application Settings
AZURE_AD_TENANT_ID=your-ad-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/your-tenant-id

# Azure AD B2C Settings (for user authentication)
AZURE_AD_B2C_TENANT_NAME=your-b2c-tenant
AZURE_AD_B2C_CLIENT_ID=your-b2c-client-id
AZURE_AD_B2C_POLICY_NAME=B2C_1_signupsignin
AZURE_AD_B2C_AUTHORITY=https://your-b2c-tenant.b2clogin.com/your-b2c-tenant.onmicrosoft.com/B2C_1_signupsignin

# ============================================================================
# AZURE COSMOS DB - Database (replaces Firestore)
# ============================================================================
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your-cosmos-primary-key
AZURE_COSMOS_DATABASE_ID=drishtix-db
AZURE_COSMOS_CONTAINER_USERS=users
AZURE_COSMOS_CONTAINER_EVENTS=events
AZURE_COSMOS_CONTAINER_ANALYTICS=analytics
AZURE_COSMOS_CONTAINER_SESSIONS=sessions

# ============================================================================
# AZURE NOTIFICATION HUBS - Push Notifications (replaces FCM)
# ============================================================================
AZURE_NOTIFICATION_HUBS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=DefaultFullSharedAccessSignature;SharedAccessKey=your-key
AZURE_NOTIFICATION_HUBS_NAME=drishtix-notifications

# ============================================================================
# AZURE SYNAPSE ANALYTICS - Data Warehouse (replaces BigQuery)
# ============================================================================
AZURE_SYNAPSE_WORKSPACE_NAME=drishtix-synapse
AZURE_SYNAPSE_SQL_ENDPOINT=your-workspace.sql.azuresynapse.net
AZURE_SYNAPSE_SPARK_POOL=drishtixspark
AZURE_SYNAPSE_SQL_POOL=drishtixsql
AZURE_SYNAPSE_USERNAME=sqladminuser
AZURE_SYNAPSE_PASSWORD=your-password
AZURE_SYNAPSE_DATASET_PREDICTIONS=crowd_predictions
AZURE_SYNAPSE_DATASET_INCIDENTS=incident_logs
AZURE_SYNAPSE_DATASET_ANALYTICS=event_analytics

# ============================================================================
# AZURE SERVICE BUS - Messaging (replaces Pub/Sub)
# ============================================================================
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key
AZURE_SERVICE_BUS_TOPIC_CROWD_DATA=crowd-density-updates
AZURE_SERVICE_BUS_TOPIC_PREDICTIONS=prediction-results
AZURE_SERVICE_BUS_TOPIC_ANOMALIES=anomaly-detections
AZURE_SERVICE_BUS_TOPIC_ALERTS=emergency-alerts
AZURE_SERVICE_BUS_TOPIC_DISPATCH=responder-dispatch
AZURE_SERVICE_BUS_TOPIC_RISK_ENGINE=risk-engine
AZURE_SERVICE_BUS_SUBSCRIPTION_CROWD=crowd-density-sub
AZURE_SERVICE_BUS_SUBSCRIPTION_PREDICTIONS=prediction-results-sub
AZURE_SERVICE_BUS_SUBSCRIPTION_ANOMALIES=anomaly-detections-sub
AZURE_SERVICE_BUS_SUBSCRIPTION_RISK_ENGINE=risk-engine-sub

# ============================================================================
# AZURE BLOB STORAGE - Object Storage (replaces Cloud Storage)
# ============================================================================
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-storage-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_SIMULATIONS=simulations
AZURE_STORAGE_CONTAINER_MODELS=models
AZURE_STORAGE_CONTAINER_VIDEOS=video-feeds

# ============================================================================
# AZURE OPENAI SERVICE - AI/ML (replaces Gemini)
# ============================================================================
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-openai-key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-ada-002
AZURE_OPENAI_DEPLOYMENT_VISION=gpt-4-vision

# ============================================================================
# AZURE MAPS - Mapping Services (replaces Google Maps)
# ============================================================================
AZURE_MAPS_SUBSCRIPTION_KEY=your-maps-subscription-key
AZURE_MAPS_CLIENT_ID=your-maps-client-id

# ============================================================================
# AZURE PLANETARY COMPUTER - Satellite Imagery (replaces Earth Engine)
# ============================================================================
AZURE_PLANETARY_COMPUTER_ENABLED=true
AZURE_PLANETARY_COMPUTER_API_KEY=your-planetary-computer-key
AZURE_PLANETARY_COMPUTER_ENDPOINT=https://planetarycomputer.microsoft.com/api/stac/v1

# ============================================================================
# AZURE SPEECH SERVICES - Speech-to-Text (replaces Cloud Speech)
# ============================================================================
AZURE_SPEECH_SUBSCRIPTION_KEY=your-speech-key
AZURE_SPEECH_REGION=eastus

# ============================================================================
# AZURE MONITOR - Logging & Monitoring (replaces Cloud Logging/Monitoring)
# ============================================================================
AZURE_MONITOR_WORKSPACE_ID=your-workspace-id
AZURE_MONITOR_INSTRUMENTATION_KEY=your-instrumentation-key
AZURE_MONITOR_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://eastus-8.in.applicationinsights.azure.com/

# ============================================================================
# AZURE MACHINE LEARNING - ML Platform (replaces Vertex AI)
# ============================================================================
AZURE_ML_WORKSPACE_NAME=drishtix-ml
AZURE_ML_ENDPOINT=https://your-ml-workspace.azureml.net
AZURE_ML_API_KEY=your-ml-api-key

# ============================================================================
# AZURE PURVIEW - Data Governance (replaces Cloud DLP)
# ============================================================================
AZURE_PURVIEW_ENABLED=true
AZURE_PURVIEW_ACCOUNT_NAME=your-purview-account
AZURE_PURVIEW_ENDPOINT=https://your-purview-account.purview.azure.com

# ============================================================================
# AZURE APP SERVICE - Web Hosting
# ============================================================================
AZURE_APP_SERVICE_NAME=drishtix-app
AZURE_APP_SERVICE_RESOURCE_GROUP=drishtix-rg

# ============================================================================
# MIGRATION NOTES
# ============================================================================
# 1. All Google Cloud Platform services have been replaced with Azure equivalents
# 2. Update your deployment scripts to use Azure CLI instead of gcloud
# 3. Update CI/CD pipelines to use Azure DevOps or GitHub Actions with Azure
# 4. Review the AZURE_MIGRATION_PLAN.md for detailed migration steps
# ============================================================================
