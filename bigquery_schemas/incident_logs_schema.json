  {"name": "location", "type": "RECORD", "mode": "NULLABLE", "description": "Incident location", "fields": [
    {"name": "lat", "type": "FLOAT64", "mode": "NULLABLE", "description": "Latitude"},
    {"name": "lng", "type": "FLOAT64", "mode": "NULLABLE", "description": "Longitude"}
  ]},
  {"name": "affected_zones", "type": "STRING", "mode": "REPEATED", "description": "List of affected zone IDs"},
  {"name": "response_time_seconds", "type": "INT64", "mode": "NULLABLE", "description": "Response time in seconds"},
  {"name": "description", "type": "STRING", "mode": "NULLABLE", "description": "Incident description"}
