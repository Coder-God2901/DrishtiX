  {"name": "timestamp", "type": "TIMESTAMP", "mode": "REQUIRED", "description": "Incident occurrence timestamp"},
  {"name": "type", "type": "STRING", "mode": "REQUIRED", "description": "Incident type (CROWD_SURGE, FIRE, MEDICAL, etc.)"},
