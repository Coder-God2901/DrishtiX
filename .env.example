# ================================
# DrishtiX - AI-Powered Crowd Safety Platform
# Environment Configuration Template
# ================================
# Copy this file to .env and fill in your actual values
# Generated: December 1, 2025
# Version: 2.0.0 - Production Ready
# See docs/COMPLETE_SETUP_GUIDE.md for setup instructions
#
# Architecture: Hybrid (Local ML + Full GCP Integration)
# - Local ML: YOLO + ConvLSTM (Cost: $0/month)
# - GCP Services: Pub/Sub, BigQuery, Firestore, Earth Engine, Maps
# - Cost Savings: 85-90% reduction vs full Vertex AI
#
# Documentation:
# - Setup: docs/COMPLETE_SETUP_GUIDE.md
# - Production: docs/PRODUCTION_READY_SUMMARY.md
# - GCP Integration: docs/GCP_INTEGRATION_VERIFICATION.md

# ================================
# SERVER CONFIGURATION
# ================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ================================
# API CONFIGURATION
# ================================
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3001

# ================================
# GOOGLE CLOUD PLATFORM (CRITICAL)
# ================================

# Core GCP Configuration
VITE_GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account-key.json
VITE_GCP_ACCESS_TOKEN=

# GCP Region Configuration
GCP_REGION=us-central1
BIGQUERY_LOCATION=US

# ================================
# FIREBASE (Authentication, FCM, Firestore)
# ================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Firebase Cloud Messaging (FCM) - Server Key for push notifications
FIREBASE_SERVER_KEY=

# Google Cloud Storage
GCS_BUCKET_NAME=drishtix-data-storage
GCS_REGION=us-central1

# BigQuery
BIGQUERY_DATASET=drishtix_analytics
BIGQUERY_LOCATION=US

# Vertex AI - Forecasting
VERTEX_AI_REGION=us-central1
VERTEX_AI_MODEL_ENDPOINT=your-model-endpoint-id
VERTEX_AI_MODEL_ID=your-endpoint-id
# ⚠️ CRITICAL: Set this after deploying model (see docs/VERTEX_AI_SETUP_GUIDE.md)
# Format: projects/PROJECT_ID/locations/REGION/endpoints/ENDPOINT_ID
# Example: projects/drishtix-prod/locations/us-central1/endpoints/1234567890123456789
VITE_VERTEX_AI_FORECASTING_ENDPOINT=

# ================================
# LOCAL ML SERVICES (Replaces Vertex AI for cost optimization)
# ================================
# ConvLSTM Forecasting Service (Local Python + TensorFlow)
ML_SERVICE_ENDPOINT=http://ml-service:8000
USE_LOCAL_ML=true
# YOLO + OpenCV Vision Service (Replaces Gemini Vision)
VISION_SERVICE_URL=http://vision-service:8001
USE_LOCAL_VISION=true
# Frame sampling rate (analyze every Nth frame for optimization)
VISION_FRAME_SAMPLING_RATE=5
# Cost Savings: Local ML ($40/month) vs Vertex AI + Gemini ($260-1200/month)

# Vertex AI - Vision (for video analytics) - OPTIONAL (using local YOLO instead)
VITE_VERTEX_AI_VISION_ENDPOINT=
# ⚠️ Set this after deploying Vertex AI Vision (see docs/VERTEX_AI_VISION_SETUP_GUIDE.md)
# Format: projects/PROJECT_ID/locations/REGION/publishers/google/models/MODEL_ID
# Example: projects/drishtix-prod/locations/us-central1/publishers/google/models/imagetext@001

# Vertex AI - Agent Builder (for intelligent dispatch)
VITE_VERTEX_AI_AGENT_ENDPOINT=https://dialogflow.googleapis.com/v3
VITE_VERTEX_AI_AGENT_ID=
# ⚠️ CRITICAL: Set Agent ID after creating agent (see docs/VERTEX_AI_AGENT_BUILDER_SETUP.md)
# Format: projects/PROJECT_ID/locations/REGION/agents/AGENT_ID
# Example: projects/drishtix-prod/locations/us-central1/agents/abc123-def456-ghi789

# GCP Access Token (for API authentication)
VITE_GCP_ACCESS_TOKEN=

# ================================
# GOOGLE MAPS PLATFORM (Navigation, Routing, Venue Mapping)
# ================================
# Setup Guide: @guides/GCP_MAPS_EARTH_PUBSUB_SETUP_GUIDE.md
# Get API keys from: https://console.cloud.google.com/google/maps-apis
# 
# How to get API key:
# 1. Enable APIs: Maps JavaScript, Directions, Routes, Places, Geocoding
# 2. Create API key in GCP Console
# 3. Restrict key to your domain (http://localhost:5173/* for dev)
# 4. Copy key below
#
# Used for:
# - Venue boundary mapping with Drawing Manager
# - Safe route calculation avoiding crowded zones
# - Gate recommendations based on wait times & crowd levels
# - Traffic-aware navigation for attendees & emergency responders
# - POI discovery (gates, medical, food, restrooms)
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_MAPS_ROUTES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_MAPS_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Note: You can use the same key for all Maps APIs (simpler) or create separate keys

# ================================
# WEATHER API (OpenWeatherMap)
# ================================
# Get API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Weather monitoring interval in milliseconds (default: 10 minutes)
WEATHER_UPDATE_INTERVAL=600000

# ================================
# CAMERA STREAMS (OpenCV + FFmpeg)
# ================================
# FFmpeg path (required for RTSP stream capture)
FFMPEG_PATH=ffmpeg
# Camera stream frame extraction rate (frames per second)
CAMERA_FPS=5
# Enable camera stream processing
ENABLE_CAMERA_STREAMS=true

# Cloud SQL (PostgreSQL with PostGIS)
CLOUD_SQL_CONNECTION_NAME=your-project:us-central1:drishtix-db
CLOUD_SQL_INSTANCE_IP=10.0.0.3

# Cloud Dataflow
DATAFLOW_TEMP_LOCATION=gs://drishtix-data-storage/dataflow-temp
DATAFLOW_REGION=us-central1

# ================================
# GOOGLE CLOUD PUB/SUB (Real-Time Event Streaming Pipeline)
# ================================
# Setup Guide: @guides/GCP_MAPS_EARTH_PUBSUB_SETUP_GUIDE.md
#
# How to enable:
# 1. Enable Pub/Sub API: gcloud services enable pubsub.googleapis.com
# 2. Create topics: gcloud pubsub topics create video-analytics (repeat for all)
# 3. Create subscriptions with DLQ: gcloud pubsub subscriptions create ...
# 4. Grant permissions: roles/pubsub.publisher, roles/pubsub.subscriber
#
# Data Sources Streaming Through Pub/Sub:
# - Drone heatmaps (crowd density from aerial view)
# - CCTV density reports (video analytics from cameras)
# - User density (GPS tracking from attendee wearables)
# - Social sentiment (Twitter/X panic detection)
# - Weather updates (alerts, temperature, conditions)
# - Traffic feeds (congestion, incidents, route changes)
# - Incident alerts (critical events, emergency dispatches)
# - Crowd predictions (ML forecasts, risk scores)
#
# Why Pub/Sub:
# - Handles high-speed real-time data without lag
# - Decouples services (publishers don't know subscribers)
# - Guaranteed delivery with retry & DLQ
# - Auto-scaling (handles spike loads)
VITE_ENABLE_PUBSUB=true

# Pub/Sub Topics (auto-created on first publish if they don't exist)
PUBSUB_TOPIC_VIDEO_ANALYTICS=video-analytics
PUBSUB_TOPIC_SOCIAL_SIGNALS=social-signals
PUBSUB_TOPIC_GPS_TRACKING=gps-tracking
PUBSUB_TOPIC_INCIDENT_ALERTS=incident-alerts
PUBSUB_TOPIC_CROWD_PREDICTIONS=crowd-predictions
PUBSUB_TOPIC_DRONE_HEATMAPS=drone-heatmaps
PUBSUB_TOPIC_CCTV_DENSITY=cctv-density-reports
PUBSUB_TOPIC_USER_DENSITY=user-density
PUBSUB_TOPIC_WEATHER_UPDATES=weather-updates
PUBSUB_TOPIC_TRAFFIC_UPDATES=traffic-updates
PUBSUB_TOPIC_RISK_ENGINE=risk-engine
PUBSUB_TOPIC_ANOMALY_EVENTS=anomaly-events
PUBSUB_TOPIC_HEATGRID_STREAM=heatgrid-stream

# Pub/Sub Subscriptions
PUBSUB_SUBSCRIPTION_RISK_ENGINE=risk-engine-sub
PUBSUB_SUBSCRIPTION_VIDEO_ANALYTICS=video-analytics-processor
PUBSUB_SUBSCRIPTION_SOCIAL_SIGNALS=social-signals-processor
PUBSUB_SUBSCRIPTION_GPS_TRACKING=gps-tracking-processor
PUBSUB_SUBSCRIPTION_CROWD_PREDICTIONS=crowd-predictions-analyzer
PUBSUB_SUBSCRIPTION_INCIDENT_ALERTS=incident-alerts-dispatcher

# Cloud Functions (Automation)
ENABLE_CLOUD_FUNCTIONS=true
# Alert Triggers - Automated SMS notifications via Twilio
# Reward Automation - Gamification with FCM push notifications
# Twilio Webhooks - Intelligent SMS/WhatsApp message processing with Gemini Pro

# Twilio Configuration (for Cloud Functions)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
# Get credentials from: https://console.twilio.com/

# Cloud Functions URLs (auto-populated after deployment)
CLOUD_FUNCTION_ALERT_TRIGGER_URL=https://us-central1-project.cloudfunctions.net/handleAlertTrigger
CLOUD_FUNCTION_REWARD_TRIGGER_URL=https://us-central1-project.cloudfunctions.net/handleRewardTrigger
CLOUD_FUNCTION_TWILIO_WEBHOOK_URL=https://us-central1-project.cloudfunctions.net/handleTwilioWebhook
# ⚠️ Configure CLOUD_FUNCTION_TWILIO_WEBHOOK_URL in Twilio Console for SMS/WhatsApp webhooks

# ================================
# CLOUD LOGGING & MONITORING
# ================================
ENABLE_CLOUD_LOGGING=true
LOG_LEVEL=info
# Alert thresholds
ALERT_FAILED_LOGIN_THRESHOLD=5
ALERT_SLOW_REQUEST_THRESHOLD=5000
ALERT_ERROR_RATE_THRESHOLD=0.05

# Backend API Base URL (for Cloud Functions callbacks)
API_BASE_URL=https://your-api.com

# Cloud Run
CLOUD_RUN_SERVICE_ACCOUNT=cloud-run-sa@your-project.iam.gserviceaccount.com
CLOUD_RUN_MAX_INSTANCES=100
CLOUD_RUN_MEMORY=2Gi

# Cloud Armor (Security)
CLOUD_ARMOR_POLICY=web-firewall
ENABLE_CLOUD_ARMOR=true

# Cloud KMS (Encryption)
KMS_KEYRING=drishtix-keys
KMS_KEY=data-encryption-key

# Cloud Logging & Monitoring
ENABLE_CLOUD_LOGGING=true
ENABLE_CLOUD_MONITORING=true
LOG_LEVEL=info

# ================================
# ================================
# GOOGLE EARTH ENGINE (Satellite Imagery & Synthetic Training Data)
# ================================
# Setup Guide: @guides/GCP_MAPS_EARTH_PUBSUB_SETUP_GUIDE.md
# 
# How to enable:
# 1. Enable Earth Engine API: gcloud services enable earthengine.googleapis.com
# 2. Register at: https://signup.earthengine.google.com/
# 3. Create service account: gcloud iam service-accounts create drishtix-ee-sa
# 4. Grant role: roles/earthengine.viewer
# 5. Download key to config/ee-service-account-key.json
#
# Used for (Hardware-Free Mode):
# - Venue map tiles from satellite imagery
# - Terrain analysis (elevation, slope, hazard zones)
# - Land cover classification (urban, vegetation, water)
# - Synthetic crowd pattern generation for ML training
# - Environmental features overlay on venue maps
#
# Production Status: ✅ Real Earth Engine API integrated
# Features: Sentinel-2 imagery, SRTM terrain, ESA WorldCover, hazard detection
# Fallback to synthetic data if API unavailable
VITE_EARTH_ENGINE_ENABLED=true
EARTH_ENGINE_ENABLED=true
EARTH_ENGINE_SERVICE_ACCOUNT=drishtix-ee-sa@YOUR_PROJECT_ID.iam.gserviceaccount.com
EARTH_ENGINE_PRIVATE_KEY_PATH=./config/ee-service-account-key.json
EARTH_ENGINE_PROJECT=YOUR_PROJECT_ID

# Optional: Mapbox for additional map styles
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Google Mobility API (for population movement trends)
GOOGLE_MOBILITY_DATA_URL=https://www.gstatic.com/covid19/mobility/Global_Mobility_Report.csv

# ================================
# Third-Party APIs
# ================================
# Twitter/X API v2 (Social Signals)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# OpenWeatherMap
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# NOAA Weather Alerts
NOAA_API_TOKEN=your-noaa-api-token

# Waze for Cities API
VITE_WAZE_API_KEY=your-waze-partnerhub-api-key
WAZE_BASE_URL=https://www.waze.com/partnerhub-api/feeds

# ================================
# Firebase Configuration
# ================================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-sender-id
ENABLE_FCM_NOTIFICATIONS=true

# Firebase Authentication (2FA/MFA)
ENABLE_FIREBASE_AUTH_2FA=true
FIREBASE_AUTH_TOTP_ISSUER=DrishtiX
FIREBASE_AUTH_SESSION_TTL=3600
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ================================
# Google Cloud Pub/Sub & Cloud Run (Video Analytics)
# ================================
VITE_GCP_PROJECT_ID=your-gcp-project-id
VITE_PUBSUB_TOPIC=drishtix-video-frames
VITE_CLOUD_RUN_ENDPOINT=https://video-processor-xxxxxx-uc.a.run.app
VITE_VERTEX_AI_VISION_ENDPOINT=https://us-central1-aiplatform.googleapis.com/v1/projects/your-project/locations/us-central1/publishers/google/models/imagetext:predict
VIDEO_FRAME_RATE=1
VIDEO_SIMULATION_ENABLED=true

# ================================
# Vertex AI Agent Builder
# ================================
VITE_VERTEX_AI_AGENT_ENDPOINT=https://us-central1-aiplatform.googleapis.com/v1/projects/your-project/locations/us-central1/agents/your-agent-id
VITE_GCP_ACCESS_TOKEN=your-gcp-access-token

# ================================
# Gemini Pro LLM
# ================================
# Get API key from: https://makersuite.google.com/app/apikey
# Free tier: 60 requests/minute
VITE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_TOKENS=2048
VITE_ENABLE_GEMINI_SUMMARIES=true

# Gemini Pro Vision (for image/video analysis & anomaly detection)
VITE_GEMINI_VISION_ENABLED=true
GEMINI_VISION_MODEL=gemini-pro-vision
# ⚠️ Enable this for real-time smoke/fire/panic detection from video feeds
# Uses same API key as Gemini Pro (VITE_GEMINI_API_KEY)
# Cost: ~$0.0025 per image (1000 images = $2.50)
# Rate limit: 60 requests/minute on free tier

# ================================
# Database Configuration
# ================================
# PostgreSQL (Cloud SQL with PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/drishtix
DB_HOST=your-cloud-sql-instance-ip
DB_PORT=5432
DB_NAME=drishtix
DB_USER=drishtix_user
DB_PASSWORD=your-secure-password
ENABLE_POSTGIS=true

# Firestore (Real-time Database)
FIRESTORE_DATABASE=(default)

# Redis (Caching & Real-time)
REDIS_URL=redis://localhost:6379
REDIS_HOST=your-redis-instance-ip
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ================================
# ML & Prediction Settings
# ================================
ML_MODEL_VERSION=v1.0
PREDICTION_LEAD_TIME_MINUTES=15
FORECAST_ACCURACY_THRESHOLD=0.75
FALSE_POSITIVE_THRESHOLD=0.15
ANOMALY_DETECTION_SENSITIVITY=medium

# ================================
# Crowd Forecasting (ConvLSTM / Multi-Mode)
# ================================
MODEL_REGISTRY_PATH=./weights
FORECAST_DEFAULT_MODE=GENERAL
FORECAST_ALLOWED_MODES=GENERAL,SPORTS,CONCERT,ENTRY_EXIT
FORECAST_BUFFER_SIZE=10
# ConvLSTM Remote Service (Python microservice)
CONVLSTM_SERVICE_ENDPOINT=http://localhost:5000
CONVLSTM_USE_REMOTE=false
# ⚠️ Set to true when Python microservice is deployed
# Python service handles TensorFlow/Keras models for spatiotemporal prediction
# See docs/TECHNICAL_DESIGN_IMPLEMENTATION_AUDIT.md for training details

# ================================
# Recommendation Engine & Risk Scoring
# ================================
# Pub/Sub Topic for risk alerts
RISK_ENGINE_PUBSUB_TOPIC=risk-engine

# Risk scoring thresholds
RISK_THRESHOLD_CRITICAL=85
RISK_THRESHOLD_HIGH=70
RISK_THRESHOLD_MEDIUM=50

# Recommendation engine configuration
RECOMMENDATION_ENGINE_ENABLED=true
RECOMMENDATION_CONTEXT_WINDOW_MINUTES=30
RECOMMENDATION_MAX_ACTIONS=5
RECOMMENDATION_MIN_CONFIDENCE=0.6

# BigQuery ETL for feedback loop (future ML retraining)
RECOMMENDATION_FEEDBACK_TABLE=drishtix_analytics.recommendation_feedback
RECOMMENDATION_FEEDBACK_DATASET=drishtix_analytics

# ================================
# Anomaly Detection (Tiered System)
# ================================
# Tier 1 (Rule-Based)
ANOMALY_TIER1_DENSITY_THRESHOLD=0.95
ANOMALY_TIER1_DELTA_THRESHOLD=50

# Tier 2 (Isolation Forest)
ANOMALY_ISOLATION_FOREST_ENABLED=true
ANOMALY_IF_THRESHOLD=-0.2
ANOMALY_IF_ENDPOINT=https://your-cloudrun-url/predict

# Tier 3 (Spatiotemporal Autoencoder)
ANOMALY_AUTOENCODER_ENABLED=true
ANOMALY_AUTOENCODER_ENDPOINT=https://vertex-ai-endpoint-placeholder
ANOMALY_AUTOENCODER_THRESHOLD=0.15

# Historical / Feature Vector Requirements
ANOMALY_MIN_ZONE_HISTORY_MINUTES=30
FEATURE_VECTOR_TABLE=event_feature_vectors
FEATURE_VECTOR_DATASET=drishtix_analytics

# Pub/Sub Topics (override if infra differs)
ANOMALY_PUBSUB_TOPIC=anomaly-events
HEATGRID_PUBSUB_TOPIC=heatgrid-stream
RISK_ENGINE_PUBSUB_TOPIC=risk-engine

# Drone / Edge Security
DRONE_MTLS_REQUIRED=true
DRONE_GEOFENCE_ENFORCED=true

# Operational Security & Monitoring
ADMIN_LOG_AUDIT=true
FAILED_LOGIN_ALERT_THRESHOLD=5
ALERT_ANOMALY_SPIKE_THRESHOLD=100

# Analytics & Monitoring
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_ANALYTICS_ID=your_analytics_id_here
ENABLE_CLOUD_LOGGING=true
LOG_LEVEL=info

# Feature Flags
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_GEOLOCATION=true
VITE_ENABLE_PWA=true
VITE_ENABLE_PREDICTIVE_ANALYTICS=true
VITE_ENABLE_SYNTHETIC_FEEDS=true
VITE_ENABLE_SOCIAL_MONITORING=true
VITE_ENABLE_AUTOMATED_ROUTING=true
VITE_ENABLE_VIDEO_ANALYTICS=true
VITE_ENABLE_TRAFFIC_FEEDS=true
VITE_ENABLE_AGENT_ORCHESTRATION=true
VITE_ENABLE_GEMINI_SUMMARIES=true
VITE_ENABLE_ATTENDEE_REPORTING=true
VITE_ENABLE_FCM_NOTIFICATIONS=true
VITE_ENABLE_DATAFLOW_PIPELINE=true
VITE_ENABLE_CONVLSTM_FORECASTING=true
VITE_ENABLE_ENSEMBLE_MODELS=true

# ================================
# Performance & Security
# ================================
DATA_REFRESH_INTERVAL_SECONDS=300
PREDICTION_UPDATE_INTERVAL_SECONDS=60
CACHE_TTL_SECONDS=600
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRATION=24h

# Role-Based Access Control (RBAC)
RBAC_ENABLED=true
RBAC_ROLES=ADMIN,ORGANIZER,SECURITY,LOGISTICS,MEDICAL,ATTENDEE,VOLUNTEER,VIEWER
REQUIRE_MFA_FOR_ADMINS=true
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT_MINUTES=60

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ISSUER=drishtix-platform
JWT_AUDIENCE=drishtix-api
JWT_EXPIRATION=24h

# Cloud DLP (PII Removal)
ENABLE_CLOUD_DLP=true
DLP_TEMPLATE=projects/your-project/locations/global/inspectTemplates/pii-detector

# VPC & Networking
VPC_NETWORK=drishtix-vpc
VPC_SUBNET=drishtix-subnet-us-central1
ENABLE_PRIVATE_IP=true

# Incident Response
ENABLE_INCIDENT_DETECTION=true
ENABLE_AUTO_CONTAINMENT=true
INCIDENT_NOTIFICATION_EMAIL=security@drishtix.com
INCIDENT_WEBHOOK_URL=https://your-webhook-url.com/incidents
